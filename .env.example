# Copy to .env and fill locally. Never commit credentials.
# CLI commands load .env automatically; exported environment variables take precedence.

# Optional twscrape account pool, one "username:password:email:email_password" per line.
# Accounts are loaded into a temporary session-scoped SQLite database.
TWSCRAPE_ACCOUNTS=

# Optional Scweet auth token (opt-in adapter; disabled by default).
SCWEET_AUTH_TOKEN=

# Optional x-cli session cookie. Written to a 0600 session file, never logged.
XCLI_SESSION_COOKIE=

# Optional AI provider. The app is fully functional with these unset.
XVOTE_AI_ENDPOINT=
XVOTE_AI_KEY=
XVOTE_AI_CONSENT=no

# Server settings
XVOTE_HOST=127.0.0.1
XVOTE_PORT=8765
# Directory for temp sessions. Defaults to a private subdirectory of the system temp dir.
XVOTE_SESSION_ROOT=

# Live acquisition acknowledgement (required before any non-fixture collection).
# Set to "yes" only when you have authorized access and will respect tool
# licenses, X's terms and access controls, and rate limits.
XVOTE_AUTHORIZED_USE_ACK=

